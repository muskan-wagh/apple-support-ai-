{
  "name": "apple-support-ai",
  "version": "0.1.0",
  "description": "AI customer-support agent for Apple Support (TWCS dataset) — Hiver SDE Intern take-home",
  "type": "module",
  "scripts": {
    "dev": "tsx src/agent/cli.ts",
    "agent": "tsx src/agent/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "data:inspect": "tsx scripts/inspectDataset.ts",
    "data:filter": "tsx scripts/filterAppleSupport.ts",
    "data:conversations": "tsx scripts/buildConversations.ts",
    "embeddings": "tsx scripts/buildEmbeddings.ts",
    "retrieval:verify": "tsx scripts/verifyRetrieval.ts",
    "intents:count": "tsx scripts/countIntents.ts",
    "golden:sample": "tsx scripts/buildGolden.ts --sample",
    "golden:finalize": "tsx scripts/finalizeGolden.ts",
    "evaluate": "tsx evaluation/run.ts",
    "evaluate:offline": "EVAL_OFFLINE=1 tsx evaluation/run.ts",
    "web": "next dev",
    "web:build": "next build",
    "web:start": "next start"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "next": "^15.5.25",
    "papaparse": "^5.4.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
  }
}
