# LLM (OpenAI-compatible). We use OpenRouter + Nex-N2.5-Mini (free).
# Get a key at https://openrouter.ai/keys and paste below. Never commit .env.
LLM_API_KEY=
LLM_MODEL=nex-agi/nex-n2.5-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional overrides
# TOP_K=3
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
